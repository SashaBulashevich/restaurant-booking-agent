# LLM (Groq): https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# Кому пише агент (менеджер ресторану в Telegram)
MANAGER_USERNAME=@restaurant_manager
# Необов'язково: числовий ID менеджера (бот спробує написати першим)
MANAGER_ID=

# --- Варіант 1: userbot (агент пише від імені вашого акаунта і може почати розмову першим)
# api_id / api_hash з https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSION=agent

# --- Варіант 2: звичайний бот (токен від @BotFather; менеджер має один раз натиснути Start)
BOT_TOKEN=
# Ваш username: агент питатиме вас у чаті з ботом про те, чого не знає
OPERATOR_USERNAME=@your_username

# Параметри броні: агент повідомляє менеджеру тільки те, що задано тут.
# Порожнє поле = агент цього не знає і за потреби спитає вас.
# Ім'я, на яке бронювати (наприклад: John Smith)
GUEST_NAME=
# Контактний телефон для ресторану (наприклад: +44 20 0000 0000)
GUEST_PHONE=
# Як агент називає того, для кого бронює: "on behalf of ..." (наприклад: John Smith)
PRINCIPAL=my client
# Кількість гостей
PARTY_SIZE=2
# Час броні на сьогодні, HH:MM за місцевим часом ресторану
BOOKING_TIME=19:00
# Часовий пояс ресторану (від нього рахується «сьогодні»): Europe/London, Europe/Kyiv, America/New_York...
TIMEZONE=Europe/London
# За скільки хвилин до броні агент уже не починає розмову
MIN_LEAD_MINUTES=30

# Голос: mirror (голосом у відповідь на голосове) | always | off
VOICE_MODE=mirror
TTS_VOICE=en-GB-RyanNeural
STT_MODEL=whisper-large-v3-turbo
