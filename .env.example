# LLM (Groq): https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# Кому пише агент (менеджер ресторану в Telegram)
MANAGER_USERNAME=@restaurant_manager
# Необов'язково: числовий ID менеджера (бот спробує написати першим)
MANAGER_ID=

# --- Варіант 1: userbot (агент пише від імені вашого акаунта і може почати розмову першим)
# api_id / api_hash з https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSION=agent

# --- Варіант 2: звичайний бот (токен від @BotFather; менеджер має один раз натиснути Start)
BOT_TOKEN=
# Ваш username: агент питатиме вас у чаті з ботом про те, чого не знає
OPERATOR_USERNAME=@your_username

# ============ Ваша бронь: ЗМІНІТЬ під себе ============
# Агент повідомляє менеджеру тільки те, що задано тут, і нічого не вигадує.

# Кількість гостей
PARTY_SIZE=2
# Час броні на СЬОГОДНІ, HH:MM за місцевим часом ресторану
BOOKING_TIME=19:00
# Часовий пояс ресторану, від нього рахується «сьогодні»
# Приклади: Europe/London, Europe/Kyiv, Europe/Warsaw, America/New_York
TIMEZONE=Europe/London

# Необов'язково. Якщо порожньо, агент спитає вас, коли менеджер цього попросить.
# Ім'я, на яке бронювати, наприклад: John Smith
GUEST_NAME=
# Контактний телефон, наприклад: +44 20 0000 0000
GUEST_PHONE=
# Від чийого імені пише агент: "booking on behalf of ...". Порожньо = "my client"
PRINCIPAL=

# ============ Технічні налаштування: можна не змінювати ============

# Агент не почне розмову, якщо до броні лишилося менше цих хвилин
MIN_LEAD_MINUTES=30

# Голосові відповіді: mirror = голосом лише у відповідь на голосове (рекомендовано),
# always = завжди голосом, off = лише текст
VOICE_MODE=mirror
# Голос озвучення (edge-tts). Британські: en-GB-RyanNeural (чоловічий), en-GB-SoniaNeural (жіночий).
# Американські: en-US-GuyNeural, en-US-JennyNeural. Мова голосу має збігатися з мовою розмови (англійська).
TTS_VOICE=en-GB-RyanNeural
# Розпізнавання голосових (Groq Whisper): whisper-large-v3-turbo швидший,
# whisper-large-v3 трохи точніший на шумних записах, але повільніший
STT_MODEL=whisper-large-v3-turbo
